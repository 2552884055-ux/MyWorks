<!-- 从 MyWorks 根目录运行：
     source devel/setup.bash && mkdir -p logs/reve && roslaunch test/integration/mid360_reve/record_alignment.launch bag_path:="$PWD/logs/reve/alignment_$(date +%Y%m%d_%H%M%S).bag"
-->
<launch>
  <arg name="bag_path"/>
  <arg name="radar_rviz" default="false"/>
  <arg name="plot" default="false"/>

  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch"/>
  <include file="$(find radar_ego_velocity_estimator)/launch/iwr6843aop_live.launch">
    <arg name="rviz" value="$(arg radar_rviz)"/>
    <arg name="plot" value="$(arg plot)"/>
  </include>

  <!-- 与 mapping_mid360.launch 保持相同的核心建图参数。 -->
  <rosparam command="load" file="$(find fast_lio_global)/config/mid360.yaml"/>
  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="point_filter_num" type="int" value="3"/>
  <param name="max_iteration" type="int" value="3"/>
  <param name="filter_size_surf" type="double" value="0.5"/>
  <param name="filter_size_map" type="double" value="0.5"/>
  <param name="cube_side_length" type="double" value="1000"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>
  <param name="pcd_save/pcd_save_en" type="bool" value="false"/>
  <param name="radar/radar_en" type="bool" value="false"/>
  <node pkg="fast_lio_global" type="fastlio_mapping_global" name="laserMapping" output="screen" required="true"/>

  <node pkg="rosbag" type="record" name="record_alignment" output="screen" required="true"
        args='-O "$(arg bag_path)" /livox/lidar /livox/imu /ti_mmwave/radar_scan_pcl /reve/velocity /Odometry'/>
</launch>
