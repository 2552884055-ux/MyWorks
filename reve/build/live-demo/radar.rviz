Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: radar
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz/PointCloud2
      Name: Radar points
      Enabled: true
      Topic: /sensor_platform/radar/scan
      Queue Size: 10
      Style: Spheres
      Size (m): 0.12
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Decay Time: 0.3
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 18
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 4
        Y: 0
        Z: 0
Window Geometry:
  Width: 900
  Height: 700
