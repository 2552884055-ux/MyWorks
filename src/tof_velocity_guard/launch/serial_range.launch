<launch>
  <arg name="port" default="/dev/ttyUSB0" />
  <arg name="baud" default="115200" />
  <arg name="min_range" default="0.03" />
  <arg name="max_range" default="1.2" />
  <arg name="field_of_view" default="0.44" />

  <node pkg="tof_velocity_guard" type="serial_range_node" name="tof" output="screen">
    <param name="port" type="str" value="$(arg port)" />
    <param name="baud" type="int" value="$(arg baud)" />
    <param name="min_range" type="double" value="$(arg min_range)" />
    <param name="max_range" type="double" value="$(arg max_range)" />
    <param name="field_of_view" type="double" value="$(arg field_of_view)" />
  </node>
</launch>
