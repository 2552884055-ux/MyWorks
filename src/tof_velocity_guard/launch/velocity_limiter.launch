<launch>
  <arg name="input_topic" default="/position_cmd" />
  <arg name="input_type" default="position_command" />
  <arg name="output_topic" default="/tof/limited_velocity" />
  <arg name="body_frame" default="body" />
  <arg name="stop_distance" default="0.35" />
  <arg name="slow_distance" default="0.9" />
  <arg name="max_horizontal_speed" default="0.3" />
  <arg name="max_vertical_speed" default="0.0" />
  <arg name="range_timeout" default="0.2" />
  <arg name="command_timeout" default="0.2" />
  <arg name="tf_timeout" default="0.15" />
  <arg name="odometry_topic" default="" />
  <arg name="odometry_timeout" default="0.2" />
  <arg name="position_gain" default="0.8" />
  <arg name="velocity_gain" default="2.0" />
  <arg name="max_horizontal_acceleration" default="0.6" />
  <arg name="acceleration_topic" default="/tof/limited_acceleration" />

  <node pkg="tof_velocity_guard" type="velocity_limiter_node" name="tof_velocity_limiter" output="screen">
    <param name="input_topic" type="str" value="$(arg input_topic)" />
    <param name="input_type" type="str" value="$(arg input_type)" />
    <param name="output_topic" type="str" value="$(arg output_topic)" />
    <param name="body_frame" type="str" value="$(arg body_frame)" />
    <param name="stop_distance" type="double" value="$(arg stop_distance)" />
    <param name="slow_distance" type="double" value="$(arg slow_distance)" />
    <param name="max_horizontal_speed" type="double" value="$(arg max_horizontal_speed)" />
    <param name="max_vertical_speed" type="double" value="$(arg max_vertical_speed)" />
    <param name="range_timeout" type="double" value="$(arg range_timeout)" />
    <param name="command_timeout" type="double" value="$(arg command_timeout)" />
    <param name="tf_timeout" type="double" value="$(arg tf_timeout)" />
    <param name="odometry_topic" type="str" value="$(arg odometry_topic)" />
    <param name="odometry_timeout" type="double" value="$(arg odometry_timeout)" />
    <param name="position_gain" type="double" value="$(arg position_gain)" />
    <param name="velocity_gain" type="double" value="$(arg velocity_gain)" />
    <param name="max_horizontal_acceleration" type="double" value="$(arg max_horizontal_acceleration)" />
    <param name="acceleration_topic" type="str" value="$(arg acceleration_topic)" />
  </node>
</launch>
