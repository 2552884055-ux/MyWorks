<launch>
  <arg name="command_port" default="/dev/serial/by-id/usb-Silicon_Labs_CP2105_Dual_USB_to_UART_Bridge_Controller_00902312-if00-port0"/>
  <arg name="data_port" default="/dev/serial/by-id/usb-Silicon_Labs_CP2105_Dual_USB_to_UART_Bridge_Controller_00902312-if01-port0"/>
  <arg name="config_file" default="$(find ti_mmwave_rospkg)/cfg/6843AOP_icins2021.cfg"/>
  <arg name="rviz" default="false"/>
  <node pkg="ti_mmwave_rospkg" type="ti_mmwave_rospkg" name="ti_mmwave" output="screen" required="true">
    <param name="command_port" value="$(arg command_port)"/>
    <param name="command_rate" value="115200"/>
    <param name="data_port" value="$(arg data_port)"/>
    <param name="data_rate" value="921600"/>
    <param name="frame_id" value="ti_mmwave"/>
    <param name="mmWaveCLI_name" value="/mmWaveCLI"/>
    <param name="max_allowed_elevation_angle_deg" value="90"/>
    <param name="max_allowed_azimuth_angle_deg" value="90"/>
  </node>
  <node pkg="ti_mmwave_rospkg" type="mmWaveQuickConfig" name="ti_mmwave_config" args="$(arg config_file)" output="screen">
    <param name="mmWaveCLI_name" value="/mmWaveCLI"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="radar_rviz" args="-d $(find ti_mmwave_rospkg)/launch/rviz/6843AOP_live.rviz">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
  </node>
</launch>
